{
  "version": "1.0",
  "defaultSchema": "WIDE",
  "schemas": [
    {
      "name": "WIDE",
      "type": "custom",
      "factory": "org.apache.calcite.adapter.file.FileSchemaFactory",
      "operand": {
        "directory": "widedata",
        "ephemeralCache": true,
        "executionEngine": "linq4j"
      }
    },
    {
      "name": "WIDEBIN",
      "type": "map",
      "tables": [
        {
          "name": "bintypes",
          "type": "view",
          "sql": "SELECT \"id\", CAST(x'DEADBEEF' AS VARBINARY) AS \"c_bin\" FROM \"WIDE\".\"widetypes\""
        }
      ]
    }
  ]
}
