#!/bin/bash
#
# postinstall for the AskAmerica MCP component package.
#
# Two jobs: prepare the shared engine cache directory, and open the setup wizard,
# which downloads the engine with a visible progress window and lets the user
# enter an API key and configure Claude Desktop.
#
# The jar goes to ~/.askamerica/engine, NOT inside the app bundle. Writing into
# a Developer ID-signed, notarized bundle invalidates its CodeResources seal,
# and ~/.askamerica/engine is where EngineInstaller and the pip client already
# look — so both installs share one copy.
#
# Installer script arguments: $1 = package path, $2 = install destination.
# Use $2 rather than a hardcoded /Applications; the destination is only fixed
# because mac-pkg/component.plist sets BundleIsRelocatable=false, and if that
# guarantee is ever broken this script fails loudly instead of writing nowhere.

set -u

log()  { echo "AskAmerica MCP: $*"; }
fail() { echo "AskAmerica MCP: ERROR: $*" >&2; }

DEST="${2:-/Applications}"
APP="$DEST/AskAmerica MCP.app"
LAUNCHER="$APP/Contents/MacOS/AskAmerica MCP"

if [ ! -x "$LAUNCHER" ]; then
  fail "no app at $APP — the payload did not land where the installer said it would."
  fail "If PackageKit logged 'relocated to', the component plist lost BundleIsRelocatable=false."
  exit 1
fi

# The GUI user, not root: the cache is per-user and the wizard must run in that
# user's session. postinstall itself runs as root.
USER_NAME=$(stat -f "%Su" /dev/console 2>/dev/null)
if [ -z "$USER_NAME" ] || [ "$USER_NAME" = "root" ]; then
  fail "no logged-in GUI user at /dev/console — cannot cache the engine or open setup."
  exit 1
fi
if ! USER_UID=$(id -u "$USER_NAME" 2>/dev/null); then
  fail "console user '$USER_NAME' is not a known account."
  exit 1
fi
USER_GROUP=$(id -gn "$USER_UID")
USER_HOME=$(dscl . -read "/Users/$USER_NAME" NFSHomeDirectory 2>/dev/null \
  | sed 's/^NFSHomeDirectory: //')
if [ -z "$USER_HOME" ] || [ ! -d "$USER_HOME" ]; then
  fail "could not resolve a home directory for $USER_NAME (got '$USER_HOME')."
  exit 1
fi

# ── Engine jar: owned by the setup wizard, not by this script ────────────────
# This used to curl the jar here as root. It worked, but it put a multi-minute
# download behind a progress bar that reports package extraction, and when it
# failed it did so non-fatally into installer.log — so the user got a fast,
# apparently-successful install and paid the cost later as an unexplained stall
# the first time Claude Desktop started the server.
#
# The wizard now owns it, which is what the Windows installer already does: its
# finish dialog launches the app and the download runs in a real progress window
# the user is looking at. Opening the app below is therefore not a convenience,
# it is the install step, so the cache directory is prepared here (as the user,
# since postinstall is root) to keep the wizard off a permissions error.

CACHE_DIR="$USER_HOME/.askamerica/engine"
JAR="$CACHE_DIR/askamerica-engine.jar"

if [ -f "$JAR" ]; then
  log "engine already cached at $JAR — the wizard will skip the download"
else
  install -d -o "$USER_NAME" -g "$USER_GROUP" -m 755 \
    "$USER_HOME/.askamerica" "$CACHE_DIR" \
    || fail "could not create $CACHE_DIR — the wizard will try again as $USER_NAME."
  log "engine not cached; the setup wizard will download it with a progress window"
fi

# ── Open the setup wizard ────────────────────────────────────────────────────
# `launchctl asuser` puts the call in the user's GUI bootstrap namespace; a bare
# `sudo -u ... open` from root's namespace fails with LSOpenURLsWithRole -600.
# Not backgrounded, so the exit status is real and gets logged.

# The final pane cannot read this script's exit status, so record the outcome
# where a user can find it. Without this a failed launch is visible only in
# installer.log, which is precisely the silence that made the old pre-warm
# failure surface later as an unexplained stall.
STATUS_DIR="$USER_HOME/.askamerica"
STATUS_FILE="$STATUS_DIR/last-install.txt"

log "opening setup wizard as $USER_NAME"
if launchctl asuser "$USER_UID" sudo -u "$USER_NAME" open "$APP"; then
  log "setup wizard launched"
  printf 'setup-wizard: opened\nengine-cached: %s\n' \
    "$([ -f "$JAR" ] && echo yes || echo 'no (wizard will download)')" \
    > "$STATUS_FILE" 2>/dev/null || true
else
  RC=$?
  fail "could not open the setup wizard (launchctl asuser exit $RC)."
  fail "Recoverable — the installer's final pane tells the user to open the app manually."
  printf 'setup-wizard: FAILED to open (exit %s)\nengine-cached: %s\naction: open "AskAmerica MCP" from Applications\n' \
    "$RC" "$([ -f "$JAR" ] && echo yes || echo no)" \
    > "$STATUS_FILE" 2>/dev/null || true
fi
chown "$USER_NAME:$USER_GROUP" "$STATUS_FILE" 2>/dev/null || true

exit 0
