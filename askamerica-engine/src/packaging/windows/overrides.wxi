<?xml version="1.0" encoding="utf-8"?>
<!--
  jpackage overridable WiX resource.

  jpackage's generated main.wxs includes overrides.wxi inside its <Product>
  element; dropping this file into the jpackage resource-dir replaces the empty
  default so its contents are spliced into the installer.

  NOTE: XML comments here must not contain a double hyphen (candle CNDL0104), so
  flag names below are written without their leading dashes.

  Why this exists:

  The stock jpackage MSI only copies the app into Program Files and adds Start-menu
  shortcuts. It never runs the setup wizard, and its final page says nothing, so a
  user who double-clicks the .msi and clicks "Finish" is left with Claude Desktop
  still unconfigured and no idea a second step exists.

  The real setup (enter API key, write claude_desktop_config.json, restart Claude
  Desktop) lives in SetupWindow, which the launcher shows only when started with no
  "mcp" flag, i.e. when the user opens "AskAmerica MCP" from the Start Menu.

  These overrides make the installer's final page (a) tell the user to do that, and
  (b) offer a checkbox that launches the app immediately so the wizard opens right
  after install.
-->
<Include>
  <!-- Instruction shown on the installer's final (Exit) page. This alone resolves
       the "no follow-up instruction" gap and needs no custom action. -->
  <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
            Value="Almost done. Open &quot;AskAmerica MCP&quot; from the Start Menu to enter your API key and connect Claude Desktop, then restart Claude Desktop." />

  <!-- Optional "launch now" checkbox on the final page, checked by default, so the
       setup wizard opens immediately instead of relying on the user finding the
       Start-menu entry. -->
  <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
            Value="Launch AskAmerica MCP now to finish setup" />
  <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

  <!-- Run the installed launcher with no arguments: with no "mcp" flag it shows the
       setup wizard (SetupWindow) rather than starting the MCP server. asyncNoWait
       so clicking Finish returns immediately. INSTALLDIR is jpackage's install
       directory property; it resolves with a trailing separator. -->
  <Property Id="WixShellExecTarget" Value="[INSTALLDIR]AskAmerica MCP.exe" />
  <CustomAction Id="LaunchApplication"
                BinaryKey="WixCA"
                DllEntry="WixShellExec"
                Impersonate="yes"
                Return="asyncNoWait" />
  <UI>
    <Publish Dialog="ExitDialog"
             Control="Finish"
             Event="DoAction"
             Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
  </UI>
</Include>
