<?xml version="1.0" encoding="utf-8"?>
<Include>
  <!-- WixUI standard dialog art, replacing the generic default. Sizes are WixUI's own
       fixed conventions: banner 493x58 (top of most wizard pages), dialog 493x312
       (Welcome/Exit page background). Built from web/icon.svg's brand colors/glyph. -->
  <WixVariable Id="WixUIBannerBmp" Value="$(var.JpConfigDir)/banner.bmp" />
  <WixVariable Id="WixUIDialogBmp" Value="$(var.JpConfigDir)/dialog.bmp" />
</Include>
