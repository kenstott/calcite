#!/usr/bin/env bash
# ============================================================================
# Parallel ETL Environment Overrides
# Copy this file to env.sh and configure tracker settings.
#
# Base credentials (AWS, API keys, etc.) are loaded from govdata/.env.prod
# This file only adds parallel-specific overrides.
# ============================================================================

# --- Pipeline Tracker (Postgres: the canonical ETL state store) ---
# Backed up by govdata/scripts/tracker-backup.sh, which is what makes depending on it safe.
export CALCITE_TRACKER_BACKEND="pg"
export GOVDATA_TRACKER_PG_URL="jdbc:postgresql://localhost:5432/govdata"
export GOVDATA_TRACKER_PG_USER="govdata"
export GOVDATA_TRACKER_PG_PASSWORD="change-me"

# --- JVM settings (override .env.prod defaults if needed) ---
# export ETL_HEAP_MIN="1g"
# export ETL_HEAP_MAX="4g"

# --- DQ bucket isolation (optional) ---
# By default, dq-rebuild reads/writes the production bucket (govdata-parquet-v1).
# Set these to use isolated DQ buckets instead, which
# avoids rclone purge Class A charges — the entire bucket is reset via the
# Cloudflare API (one HTTP call) instead of per-object deletes.
#
# CF_ACCOUNT_ID and CF_API_TOKEN (r2:write permission) are only required when
# GOVDATA_DQ_BUCKET is set to a non-production bucket.
#
# export GOVDATA_DQ_BUCKET="govdata-parquet-v1-dq"
# export GOVDATA_DQ_TRACKER_BUCKET="govdata-tracker-v1-dq"
# export CF_ACCOUNT_ID="your-cloudflare-account-id"
# export CF_API_TOKEN="your-cloudflare-api-token"
